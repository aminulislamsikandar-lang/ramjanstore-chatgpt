{
  "name": "ramjanstore",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*", "backend"],
  "scripts": {
    "dev:storefront": "npm --workspace apps/storefront run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm run build:storefront && npm run build:admin && npm run build:backend",
    "build:storefront": "npm --workspace apps/storefront run build",
    "build:admin": "npm --workspace apps/admin run build",
    "build:backend": "npm --workspace backend run build",
    "type-check": "npm run type-check:types && npm run type-check:storefront && npm run type-check:admin && npm run type-check:backend",
    "type-check:types": "npm --workspace packages/types exec tsc --noEmit",
    "type-check:storefront": "npm --workspace apps/storefront exec tsc --noEmit",
    "type-check:admin": "npm --workspace apps/admin exec tsc --noEmit",
    "type-check:backend": "npm --workspace backend exec tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": { "node": ">=20" },
  "devDependencies": { "prettier": "^3.6.2", "typescript": "^5.9.2" }
}
